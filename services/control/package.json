    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@trpc/client": "^11.19.0",
    "@types/node": "^22.20.1",
    "vitest": "^2.1.9",
    "tsx": "^4.19.0"
  }
