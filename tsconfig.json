{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src/**/*",
    "packages/connectors/*/src/**/*",
    "services/*/src/**/*",
    "evals/*/src/**/*",
    "scripts/**/*",
    "packages/*/test/**/*",
    "packages/connectors/*/test/**/*",
    "services/*/test/**/*",
    "evals/*/test/**/*",
    "e2e/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/.next"
  ]
}
