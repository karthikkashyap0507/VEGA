# =============================================================================
# VEGA — environment template
# =============================================================================
# Copy to `.env` and fill in.  `.env` is gitignored; NEVER commit real secrets.
#
#   cp .env.example .env
#
# Keys are grouped by WHEN YOU ACTUALLY NEED THEM.  Everything in [MODULE 1] runs
# locally from `pnpm stack:up` — you do not need to sign up for anything to start.
# =============================================================================


# =============================================================================
# [MODULE 1 — LOCAL]  No external accounts required. Defaults work as-is.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# --- Ports -------------------------------------------------------------------
GATEWAY_PORT=3001
CONTROL_PORT=3002
EXECUTION_PORT=3003
EVIDENCE_PORT=3004
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
GATEWAY_PUBLIC_URL=http://localhost:3001

# --- PRIMARY database (control + execution planes) ---------------------------
# Local: provided by infra/docker/docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vega
POSTGRES_USER=vega
POSTGRES_PASSWORD=vega_local_dev_only
DATABASE_URL=postgresql://vega:vega_local_dev_only@localhost:5432/vega

# Least-privilege application role. RLS is FORCEd, so even the owner is filtered,
# but the app must never connect as the owner in any deployed environment.
DATABASE_APP_URL=postgresql://vega_app:vega_app_local_dev_only@localhost:5432/vega

# --- EVIDENCE database (Module 7) --------------------------------------------
# PHYSICALLY SEPARATE INSTANCE. This is invariant 1 (docs/PROJECT.md 10.2):
# the execution plane may APPEND and nothing else.
# In production these credentials must not exist anywhere the execution plane runs.
EVIDENCE_DATABASE_URL=postgresql://vega_eviaddr:vega_evi_local_dev_only@localhost:5433/vega_evidence
# INSERT-only role used by the evidence service writer path:
EVIDENCE_WRITER_URL=postgresql://vega_evi_writer:vega_evi_writer_local@localhost:5433/vega_evidence

# --- Valkey (cache, leases, rate limits) -------------------------------------
# Valkey, not Redis — see docs/TECHSTACK.md 7.1
VALKEY_URL=redis://localhost:6379

# --- Zitadel (identity, Module 1) --------------------------------------------
# Local: docker-compose starts Zitadel and seeds an admin.
# You create the project + app in the Zitadel console on first run, then paste here.
# Console: http://localhost:8080  (see docs/module1-implementation-plan.md step 4)
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_REDIRECT_URI=http://localhost:3001/v1/oauth/callback
# Service-account key (JSON) used to provision orgs + machine users for agents:
ZITADEL_SERVICE_ACCOUNT_KEY_PATH=./infra/docker/secrets/zitadel-sa.json

# --- OpenFGA (fine-grained authz, Module 1) ----------------------------------
OPENFGA_API_URL=http://localhost:8081
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
# Local dev runs OpenFGA without auth; production uses a preshared key:
OPENFGA_API_TOKEN=

# --- Session / cookie signing (Module 1) -------------------------------------
# Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
SESSION_TTL_SECONDS=3600
REFRESH_TTL_SECONDS=2592000

# --- Local envelope-encryption key (stands in for KMS until deploy) ----------
# Generate: openssl rand -base64 32
# Production: replaced by KMS_KEY_ID below. Never ship a local key to an environment.
LOCAL_KEK_BASE64=CHANGE_ME_generate_with_openssl_rand_base64_32

# --- Telemetry (Module 1) ----------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=vega
OTEL_TRACES_SAMPLER=parentbased_always_on


# =============================================================================
# [MODULE 2 — CONNECTORS]  External accounts required. Start OAuth verification
# EARLY: approval is calendar time, not engineering time (docs/module2.md 14).
# =============================================================================

# --- Google Cloud (Gmail, Calendar, Drive) -----------------------------------
# console.cloud.google.com -> new project -> enable Gmail/Calendar/Drive APIs
# -> OAuth consent screen -> Credentials -> OAuth client ID (Web application)
# Redirect URI: http://localhost:3001/v1/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft (Outlook, Exchange, SharePoint) -------------------------------
# portal.azure.com -> Microsoft Entra ID -> App registrations -> New registration
# Redirect URI: http://localhost:3001/v1/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Slack -------------------------------------------------------------------
# api.slack.com/apps -> Create New App
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- Web search (optional; SearXNG self-hosted is the OSS route) -------------
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8888
SEARCH_API_KEY=


# =============================================================================
# [MODULES 3-4 — MODELS]  The first paid API key you actually need.
# =============================================================================

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Model pinning. Versions are recorded per run and REQUIRED for replay (M7) and
# certification (M10). Changing one invalidates certification — see PROJECT.md 8.2.4.
MODEL_PLANNER=claude-opus-5
MODEL_ROUTINE=claude-sonnet-5
MODEL_EXTRACTOR=claude-haiku-4-5-20251001

# LiteLLM gateway (Module 5 owns the routing policy above it — decision D-12)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=

# Langfuse (self-hosted tracing + prompt/version registry)
LANGFUSE_HOST=http://localhost:3030
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=


# =============================================================================
# [MODULES 5-9 — SUPPORTING SERVICES]
# =============================================================================

# --- OPA (Module 5) ----------------------------------------------------------
OPA_URL=http://localhost:8181
OPA_BUNDLE_SIGNING_KEY=

# --- Presidio PII/PHI detection sidecar (Module 5) ---------------------------
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001

# --- Temporal (Module 4) -----------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Object storage: content-addressed store + WORM (Modules 6/7) ------------
# Local: SeaweedFS from docker-compose.
# PRODUCTION WORM: use cloud S3 Object Lock. MinIO is ARCHIVED (Apr 2026) and
# SeaweedFS COMPLIANCE mode has an unresolved enforcement issue — see TECHSTACK 11.3.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vega_local
S3_SECRET_ACCESS_KEY=vega_local_dev_only
S3_BUCKET_CONTENT=vega-content
S3_BUCKET_EVIDENCE=vega-evidence

# --- vLLM: self-hosted embeddings + reranker (Module 9) ----------------------
# Self-hosted deliberately: keeps document content inside the perimeter and removes
# a per-document API cost that scales with every connected mailbox (TECHSTACK 14).
VLLM_EMBEDDINGS_URL=http://localhost:8000
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3


# =============================================================================
# [MODULE 7 — SIGNING]  Deliberate non-OSS exception (TECHSTACK 22.2).
# The execution plane's IAM role must NOT be able to invoke this key.
# =============================================================================

# Local dev signs with a file-based key. Production MUST use KMS/HSM.
SIGNING_MODE=local
SIGNING_LOCAL_KEY_PATH=./infra/docker/secrets/signing-dev.key
KMS_PROVIDER=
KMS_KEY_ID=
TRILLIAN_LOG_URL=http://localhost:8090
TRILLIAN_TREE_ID=


# =============================================================================
# [MODULE 10 / DEPLOY]
# =============================================================================

BILLING_PROVIDER=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

# Push notifications (Module 8). ntfy is the self-hosted option.
NTFY_URL=http://localhost:8090
FCM_SERVER_KEY=

# Data residency for this deployment (tenants.region defaults to it)
DEFAULT_REGION=eu-west-1
