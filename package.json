{
  "name": "vega",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=./services/* --filter=./apps/*",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @vega/db generate",
    "db:migrate": "pnpm --filter @vega/db migrate",
    "db:seed": "pnpm --filter @vega/db seed",
    "stack:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "stack:down": "docker compose -f infra/docker/docker-compose.yml down",
    "stack:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "stack:reset": "docker compose -f infra/docker/docker-compose.yml down -v",
    "verify:invariants": "node scripts/verify-invariants.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "docker compose -f infra/docker/docker-compose.yml down -v && docker compose -f infra/docker/docker-compose.yml up -d postgres",
    "idp:bootstrap": "tsx --env-file-if-exists=.env scripts/zitadel-bootstrap.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "globals": "^17.11.0",
    "pg": "^8.23.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
