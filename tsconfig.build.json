{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "outDir": "dist"
  },
  "include": [
    "packages/*/src/**/*",
    "packages/connectors/*/src/**/*",
    "services/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/*.test.ts"
  ]
}
