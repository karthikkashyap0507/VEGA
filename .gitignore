# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.next/
out/
*.tsbuildinfo
.turbo/

# environment - NEVER commit real secrets
.env
.env.*
!.env.example

# credential material - deny by default, allow only placeholders
infra/docker/secrets/*
!infra/docker/secrets/.gitkeep
*.pem
*.key
*.p12
*.pfx
*-key.json
*service-account*.json
*credentials*.json
# Zitadel downloads keys named <keyId>.json
[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*.json

# local data
*.log
coverage/
.vitest/
tmp/
.DS_Store
Thumbs.db

# local stack volumes
infra/docker/volumes/

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# playwright
test-results/
playwright-report/
